{
  "name": "dsh-doubt",
  "version": "0.3.0",
  "description": "分层取证替代「你确定吗」：插件每轮结束自己跑本机确定性 oracle 与多来源交叉，把实测证据注入下一轮；离线时用无草稿上下文的独立重推导+多数投票；附 verify_claims 取证工具。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./scanner": {
      "types": "./lib/scanner.d.ts",
      "default": "./lib/scanner.js"
    },
    "./verify": {
      "types": "./lib/verify.d.ts",
      "default": "./lib/verify.js"
    },
    "./evidence": {
      "types": "./lib/evidence.d.ts",
      "default": "./lib/evidence.js"
    },
    "./local": {
      "types": "./lib/local.d.ts",
      "default": "./lib/local.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node test/scanner.test.mjs && node test/verify.test.mjs && node test/local.test.mjs && node test/evidence.test.mjs && node test/factored.test.mjs && node test/loop.test.mjs",
    "smoke": "node test/smoke.mjs",
    "audit": "node scripts/audit.mjs",
    "verify": "npm run check && npm run build && npm test && npm run smoke && npm run audit",
    "install:local": "node scripts/install-local.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "hallucination",
    "self-verification",
    "fact-check",
    "agent",
    "答案复核",
    "幻觉",
    "自检"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_NAME/dsh-doubt.git"
  },
  "homepage": "https://github.com/YOUR_NAME/dsh-doubt#readme",
  "bugs": {
    "url": "https://github.com/YOUR_NAME/dsh-doubt/issues"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/YOUR_NAME/dsh-doubt/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/YOUR_NAME/dsh-doubt/archive/refs/heads/main.zip",
      "git": "https://github.com/YOUR_NAME/dsh-doubt.git"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "^24",
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dshTarget": "0.2.0-rc.2"
}
