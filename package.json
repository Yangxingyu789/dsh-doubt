{
  "name": "dsh-doubt",
  "version": "0.1.6",
  "description": "Evidence-first completion guard for DSH: a pre-execution gate for live mutations, tool-backed final-answer review, and a verify_claims tool for local checks.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./scanner": {
      "types": "./lib/scanner.d.ts",
      "default": "./lib/scanner.js"
    },
    "./verify": {
      "types": "./lib/verify.d.ts",
      "default": "./lib/verify.js"
    },
    "./evidence": {
      "types": "./lib/evidence.d.ts",
      "default": "./lib/evidence.js"
    },
    "./local": {
      "types": "./lib/local.d.ts",
      "default": "./lib/local.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "assets",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node test/scanner.test.mjs && node test/verify.test.mjs && node test/local.test.mjs && node test/evidence.test.mjs && node test/factored.test.mjs && node test/loop.test.mjs && node test/operations.test.mjs && node test/segments.test.mjs && node test/review-draft.test.mjs && node test/guard.test.mjs && node test/review-effort.test.mjs && node test/token-budget.test.mjs",
    "smoke": "node test/smoke.mjs",
    "audit": "node scripts/audit.mjs",
    "doctor": "node scripts/doctor.mjs",
    "host:unpack": "node scripts/unpack-host.mjs",
    "verify:independent": "node scripts/verify-independent.mjs",
    "verify:host": "node test/host.test.mjs",
    "verify:host-loop": "node test/host-loop.test.mjs && node test/host-loop.test.mjs --exhausted && node test/host-loop.test.mjs --reviewer-error && node test/host-loop.test.mjs --history && node test/host-loop.test.mjs --receipt-misuse",
    "eval:review": "node eval/review-live.mjs",
    "eval:corpus": "node eval/corpus.mjs",
    "eval:extract": "node eval/extract.mjs",
    "eval:sample": "node eval/sample.mjs --per 3",
    "eval:score": "node eval/score.mjs --claims eval/out/claims-v1.json",
    "eval:delta": "node eval/delta.mjs",
    "verify": "npm run check && npm run build && npm test && npm run smoke && npm run audit && npm run verify:host && npm run verify:host-loop && npm run verify:independent",
    "install:local": "node scripts/install-local.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "hallucination",
    "self-verification",
    "fact-check",
    "agent",
    "answer-review",
    "self-check"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/Yangxingyu789/dsh-doubt/releases/download/v0.1.6/dsh-doubt-0.1.6.tgz",
      "zip": "https://github.com/Yangxingyu789/dsh-doubt/archive/refs/tags/v0.1.6.zip",
      "git": "https://github.com/Yangxingyu789/dsh-doubt.git"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "^24",
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dshTarget": "0.2.0-rc.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yangxingyu789/dsh-doubt.git"
  },
  "homepage": "https://github.com/Yangxingyu789/dsh-doubt#readme",
  "bugs": {
    "url": "https://github.com/Yangxingyu789/dsh-doubt/issues"
  },
  "author": "Yangxingyu789"
}
