{
  "name": "dsh-doubt",
  "version": "0.5.1",
  "description": "最终正文显示前审核实际工具证据；缺少验收时自动退回补查，无法验证时明确报告未完成。保留分层断言检查与文档溯源。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./scanner": {
      "types": "./lib/scanner.d.ts",
      "default": "./lib/scanner.js"
    },
    "./verify": {
      "types": "./lib/verify.d.ts",
      "default": "./lib/verify.js"
    },
    "./evidence": {
      "types": "./lib/evidence.d.ts",
      "default": "./lib/evidence.js"
    },
    "./local": {
      "types": "./lib/local.d.ts",
      "default": "./lib/local.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "assets/icon.png",
    "assets/icon-256.png",
    "assets/icon.ico",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node test/scanner.test.mjs && node test/verify.test.mjs && node test/local.test.mjs && node test/evidence.test.mjs && node test/factored.test.mjs && node test/loop.test.mjs && node test/operations.test.mjs",
    "smoke": "node test/smoke.mjs",
    "audit": "node scripts/audit.mjs",
    "host:unpack": "node scripts/unpack-host.mjs",
    "verify:independent": "node scripts/verify-independent.mjs",
    "verify:host": "node test/host.test.mjs",
    "verify:host-loop": "node test/host-loop.test.mjs && node test/host-loop.test.mjs --exhausted && node test/host-loop.test.mjs --reviewer-error && node test/host-loop.test.mjs --history",
    "eval:review": "node eval/review-live.mjs",
    "eval:corpus": "node eval/corpus.mjs",
    "eval:extract": "node eval/extract.mjs",
    "eval:sample": "node eval/sample.mjs --per 3",
    "eval:score": "node eval/score.mjs --claims eval/out/claims-v1.json",
    "eval:delta": "node eval/delta.mjs",
    "verify": "npm run check && npm run build && npm test && npm run smoke && npm run audit && npm run verify:host && npm run verify:host-loop && npm run verify:independent",
    "install:local": "node scripts/install-local.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "hallucination",
    "self-verification",
    "fact-check",
    "agent",
    "答案复核",
    "幻觉",
    "自检"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/Yangxingyu789/dsh-doubt/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/Yangxingyu789/dsh-doubt/archive/refs/heads/main.zip",
      "git": "https://github.com/Yangxingyu789/dsh-doubt.git"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "^24",
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dshTarget": "0.2.0-rc.2"
}
